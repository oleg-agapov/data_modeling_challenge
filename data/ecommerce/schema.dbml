// E-commerce source data schema
// Matches the CSV files in data/ecommerce/. Full documentation: data/ecommerce.md
// Paste into https://dbdiagram.io to view the diagram.

Project ecommerce {
  database_type: 'DuckDB'
  Note: 'Raw source tables for the data modeling challenge (synthetic furniture store, US only, 2024-03-15 to 2026-03-15)'
}

Table users {
  user_id     text      [pk, note: 'UUID, unique user identifier']
  first_name  text      [note: 'First name']
  last_name   text      [note: 'Last name']
  email       text      [note: 'Email address; NOT unique (317 duplicates)']
  created_at  timestamp [note: 'Account creation (sign-up) time']
  location_id text      [note: 'FK to locations.location_id; one address per user']

  Note: '12,483 rows. One row per registered user.'
}

Table locations {
  location_id       text [pk, note: 'UUID, unique address identifier']
  country_code      text [note: 'Always US']
  country_full_name text [note: 'Always United States']
  city              text [note: 'City']
  address           text [note: 'Street address line']
  zip_code          text [note: '5-digit ZIP code; keep as text (leading zeros)']
  state             text [note: 'US state name']

  Note: '12,483 rows. One row per address; each address belongs to exactly one user.'
}

Table products {
  id          text    [pk, note: 'UUID, unique product identifier (last column in the CSV)']
  name        text    [note: 'Product name']
  category    text    [note: 'Living Room, Bedroom or Kitchen']
  description text    [note: 'Marketing description']
  price       decimal [note: 'Current catalog price']
  dimensions  text    [note: 'Free text, width x depth x height in cm, e.g. "220 x 90 x 75"']
  material    text    [note: 'Main material']
  stock       integer [note: 'Units in stock at export time (snapshot)']

  Note: '21 rows. One row per product.'
}

Table orders {
  order_id       text      [pk, note: 'UUID, unique order identifier']
  user_id        text      [note: 'FK to users.user_id']
  order_date     timestamp [note: 'When the order was placed']
  order_status   text      [note: 'pending, shipped, delivered or cancelled (current status only)']
  payment_method text      [note: 'paypal, bank transfer or credit card']
  updated_at     timestamp [note: 'Last update time; always equal to order_date']

  Note: '1,918 rows. One row per order.'
}

Table order_items {
  order_item_id text    [pk, note: 'UUID, unique order line identifier']
  order_id      text    [note: 'FK to orders.order_id']
  product_id    text    [note: 'FK to products.id']
  quantity      integer [note: 'Units bought; always 1']
  unit_price    decimal [note: 'Price per unit charged on this order']
  discount      decimal [note: 'Discount RATE: 0, 0.1, 0.15 or 0.2']
  line_total    decimal [note: 'quantity * unit_price * (1 - discount)']

  Note: '2,092 rows. One row per product line in an order.'
}

Table user_events {
  event_id           text      [pk, note: 'UUID, unique event identifier']
  user_id            text      [note: 'FK to users.user_id']
  event_type         text      [note: 'user_sign_up, page_view or add_to_cart']
  event_timestamp    timestamp [note: 'When the event happened; not unique per user']
  page_url           text      [note: '/signup, /catalog, /product, /checkout, /about_us, /product/add_to_cart']
  product_id         text      [null, note: 'FK to products.id; set only for product views and add_to_cart']
  additional_details text      [null, note: 'Always empty']

  Note: '191,157 rows. One row per tracked website event.'
}

Ref: users.location_id - locations.location_id
Ref: orders.user_id > users.user_id
Ref: order_items.order_id > orders.order_id
Ref: order_items.product_id > products.id
Ref: user_events.user_id > users.user_id
Ref: user_events.product_id > products.id
